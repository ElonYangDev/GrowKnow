# ================= growknow deployment parameters =================
# Copy this file to .env and edit it as needed; every field falls back to the default shown in compose.
# 把本文件复制为 .env 后按需修改；不填的字段走 docker-compose.yml 里的默认值。
# Change these before the first `docker compose up -d --build`; LLM / Embedding / MinerU can also be set later on the WebUI "System Settings" page, which takes precedence over .env.
# 建议在首次 `docker compose up -d --build` 之前改好；LLM / Embedding / MinerU 之后也可以在 WebUI「系统设置」页面修改，页面配置优先于 .env。

# ---- Public port ----
# Host port serving the GrowKnow WebUI and the /api reverse proxy.
# 宿主机端口，同时提供 WebUI 与 /api 反向代理。
WEB_PORT=8090


# ---- Initial model configuration (optional) ----
# LLM (OpenAI-compatible, any provider or a local deployment such as vLLM / Ollama)
# LLM（兼容 OpenAI 协议，种类不限，网络服务商或本地部署的均可，例如 vLLM / Ollama）
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Embedding model (OpenAI-compatible, any provider or a local deployment, e.g. bge-m3, Qwen3-Embedding)
# Embedding 模型（兼容 OpenAI 协议，种类不限，网络服务商或本地部署的均可，例如 bge-m3、Qwen3-Embedding）
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# Keys are stored on the server side only and are never echoed back to the browser.
# API Key 只保存在服务端，页面回显时脱敏。


# ---- MinerU (document layout processing) ----
# GrowKnow does not ship MinerU. MINERU_MODE picks which of the three sources to call:
#   agent      official lightweight API: no token, rate-limited by IP, 10MB / 20 pages, Markdown only (default, good for a first try)
#   precision  official precision API: token required, 200MB / 200 pages, returns structured page blocks
#   selfhost   MinerU you deploy yourself: follow https://opendatalab.github.io/MinerU/quick_start/
#              and start it with `mineru-kit api-server --host 0.0.0.0 --port 8000 --tier standard`,
#              then put its address in MINERU_URL below. GrowKnow runs in a container, where
#              127.0.0.1 points at the container itself, so a MinerU on the same machine should be
#              written as http://host.docker.internal:8000
# GrowKnow 不含 MinerU，MINERU_MODE 决定调用哪一种来源：
#   agent      官方轻量 API，免 Token、按 IP 限频，10MB / 20 页，仅 Markdown（默认，适合快速体验）
#   precision  官方精准 API，需要 Token，200MB / 200 页，返回结构化页块
#   selfhost   你自己部署的 MinerU：按官方手册 https://opendatalab.github.io/MinerU/quick_start/
#              起服务（mineru-kit api-server --host 0.0.0.0 --port 8000 --tier standard），
#              再把地址填到下面的 MINERU_URL。GrowKnow 跑在容器里，容器内的 127.0.0.1
#              指向容器自身，所以 MinerU 在同一台机器上时写 http://host.docker.internal:8000
MINERU_MODE=agent
# selfhost: the address of your own MinerU. Leave empty for precision / agent (they call mineru.net's v4 / v1/agent endpoints)
# selfhost：你自己的 MinerU 地址；precision / agent 留空即可（分别走 mineru.net 的 v4 / v1/agent 接口）
MINERU_URL=
# Required for precision (apply in the mineru.net console); optional for selfhost
# precision 必填（mineru.net 控制台申请）；selfhost 可选
MINERU_API_KEY=
# Only used by selfhost: flash / standard / advanced, and it must match the --tier you started api-server with
# 仅 selfhost 生效：flash / standard / advanced，需与你启动 api-server 时的 --tier 一致
MINERU_TIER=standard
# Language passed to the parser; default ch
# 解析语言，默认 ch
MINERU_LANGUAGE=ch


# ---- Host data directory ----
# Root directory for all persistent state on the host. Relative paths are resolved against the
# directory holding docker-compose.yml; absolute paths work too (D:/growknow-data, /srv/growknow).
# GrowKnow creates the subdirectories on first run:
#   postgres/         PostgreSQL + pgvector + Apache AGE — knowledge bases, files, chunks, triples,
#                     graph, skills and settings, i.e. everything GrowKnow has learned
#   uploads/          the original files you uploaded
#   work/             parsing intermediates, cleaned up automatically when a task finishes
#   opencode/config   opencode provider configuration, generated from System Settings
#   opencode/share    opencode session data
# Set this once before the first start: GrowKnow does not move existing data for you, so pointing at
# a fresh directory means starting with empty knowledge bases (move the folders first, then restart).
# 宿主机数据根目录。相对路径按 docker-compose.yml 所在目录解析，也支持绝对路径（D:/growknow-data、/srv/growknow）。
# 首次运行时 GrowKnow 会自动创建以下子目录：
#   postgres/         PostgreSQL + pgvector + Apache AGE，知识库 / 文件 / 切片 / 三元组 / 图谱 / skill / 设置
#   uploads/          上传的原始文件
#   work/             解析中间产物，任务结束自动清理
#   opencode/config   opencode provider 配置（由系统设置自动生成）
#   opencode/share    opencode 会话数据
# 请在首次启动前定好这个值：GrowKnow 不会替你搬数据，换成新目录等于从空知识库开始
# （要迁移就先停容器、整体移动目录，再改这里重启）。
HOST_DATA_DIR=./data


# ---- PostgreSQL ----
PG_USER=growknow
PG_PASSWORD=aD9!1pa934bKaL86
PG_DATABASE=growknow
# Host port for reaching the database directly (debug only, bound to 127.0.0.1); the containers talk to it over the internal network
# 宿主机上直连数据库的端口（仅调试用，只绑 127.0.0.1）；容器之间走内部网络
PG_PORT=5434

# ---- Knowledge graph (Apache AGE) ----
# AGE_GRAPH_NAME must differ from PG_USER (the graph lives in its own schema, and an identical name is shadowed by the user schema)
# AGE_GRAPH_NAME 不能与 PG_USER 同名（图库是独立 schema，同名会被用户 schema 遮蔽）
AGE_GRAPH_NAME=growknow_graph
# Rendering limits per request (with many nodes the frontend draws only the most connected ones)
# 单次渲染上限（节点多时前端只画关联度最高的一部分）
GRAPH_RENDER_MAX_NODES=800
GRAPH_RENDER_MAX_EDGES=2000

# ---- Extraction pipeline (usually left alone) ----
# 抽取流水线（一般无需修改）
EXTRACT_CONCURRENCY=2
OPENCODE_TIMEOUT_SECONDS=900
MAX_EXTRACT_CHARS=8000
VECTOR_CHUNK_CHARS=1200
VECTOR_CHUNK_OVERLAP=120
